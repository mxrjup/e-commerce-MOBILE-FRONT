# Public settings only; never put a client secret in a mobile app.
# Local Keycloak without a path prefix. INFRA deployment: use its public URL including /auth,
# for example https://infra.example.com/auth (replace with your deployment's hostname).
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8180
EXPO_PUBLIC_KEYCLOAK_REALM=ecommerce
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=mobile-app

# API gateway. Android emulator: use 10.0.2.2; physical phone: use your PC's LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
